; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

@types_05.i = internal global i32 0
@types_05.r = internal global float 0.000000e+00

define i32 @main(i32 %0, i8** %1) {
.entry:
  call void @_lpython_call_initial_functions(i32 %0, i8** %1)
  store float 2.000000e+00, float* @types_05.r, align 4
  store float 2.000000e+00, float* @types_05.r, align 4
  store float 8.000000e+00, float* @types_05.r, align 4
  store float 4.000000e+00, float* @types_05.r, align 4
  store float 0.000000e+00, float* @types_05.r, align 4
  store float 5.000000e-01, float* @types_05.r, align 4
  store float 5.000000e-01, float* @types_05.r, align 4
  store i32 2, i32* @types_05.i, align 4
  store i32 2, i32* @types_05.i, align 4
  store i32 8, i32* @types_05.i, align 4
  store i32 4, i32* @types_05.i, align 4
  store i32 0, i32* @types_05.i, align 4
  store i32 0, i32* @types_05.i, align 4
  store i32 0, i32* @types_05.i, align 4
  br label %return

return:                                           ; preds = %.entry
  br label %FINALIZE_SYMTABLE_types_05

FINALIZE_SYMTABLE_types_05:                       ; preds = %return
  call void @_lfortran_internal_alloc_finalize()
  ret i32 0
}

declare void @_lpython_call_initial_functions(i32, i8**)

declare void @_lfortran_internal_alloc_finalize()
