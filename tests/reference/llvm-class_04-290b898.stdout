; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

%foo_c.8 = type { %foo_b.7, %bar_c.6 }
%foo_b.7 = type { %foo_a.4, %bar_b.5 }
%foo_a.4 = type { %bar_a.3 }
%bar_a.3 = type { i32 }
%bar_b.5 = type { %bar_a.3, i32 }
%bar_c.6 = type { %bar_b.5, i32 }
%string_descriptor = type { i8*, i64 }

@main.foo = internal global %foo_c.8 zeroinitializer
@main.foo.__struct_init = internal global i1 false
@0 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@serialization_info = private unnamed_addr constant [3 x i8] c"I4\00", align 1
@1 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@2 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@serialization_info.1 = private unnamed_addr constant [3 x i8] c"I4\00", align 1
@3 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@4 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@serialization_info.2 = private unnamed_addr constant [3 x i8] c"I4\00", align 1
@5 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@"ERROR STOP" = private unnamed_addr constant [11 x i8] c"ERROR STOP\00", align 1
@6 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@7 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1

define i32 @main(i32 %0, i8** %1) {
.entry:
  %stringFormat_desc4 = alloca %string_descriptor, align 8
  %2 = alloca i32, align 4
  %3 = alloca i64, align 8
  %stringFormat_desc1 = alloca %string_descriptor, align 8
  %4 = alloca i32, align 4
  %5 = alloca i64, align 8
  %stringFormat_desc = alloca %string_descriptor, align 8
  %6 = call i8* @_lfortran_get_default_allocator()
  %7 = alloca i32, align 4
  %8 = alloca i64, align 8
  call void @_lpython_call_initial_functions(i32 %0, i8** %1)
  %9 = load i1, i1* @main.foo.__struct_init, align 1
  br i1 %9, label %struct_init_done, label %struct_init

struct_init:                                      ; preds = %.entry
  store i1 true, i1* @main.foo.__struct_init, align 1
  br label %struct_init_done

struct_init_done:                                 ; preds = %struct_init, %.entry
  store i32 -20, i32* getelementptr inbounds (%foo_c.8, %foo_c.8* @main.foo, i32 0, i32 0, i32 0, i32 0, i32 0), align 4
  store i32 9, i32* getelementptr inbounds (%foo_c.8, %foo_c.8* @main.foo, i32 0, i32 0, i32 1, i32 1), align 4
  store i32 11, i32* getelementptr inbounds (%foo_c.8, %foo_c.8* @main.foo, i32 0, i32 1, i32 1), align 4
  %10 = load i32, i32* getelementptr inbounds (%foo_c.8, %foo_c.8* @main.foo, i32 0, i32 0, i32 0, i32 0, i32 0), align 4
  store i32 %10, i32* %7, align 4
  %11 = call i8* (i8*, i8*, i64, i8*, i64*, i32, i32, i32, i32, i32, i32, i32, i32, i8**, ...) @_lcompilers_string_format_fortran(i8* %6, i8* null, i64 0, i8* getelementptr inbounds ([3 x i8], [3 x i8]* @serialization_info, i32 0, i32 0), i64* %8, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i8** null, i32* %7)
  %12 = load i64, i64* %8, align 8
  %13 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 0
  store i8* %11, i8** %13, align 8
  %14 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 1
  store i64 %12, i64* %14, align 8
  %15 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 0
  %16 = load i8*, i8** %15, align 8
  %17 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 1
  %18 = load i64, i64* %17, align 8
  %19 = trunc i64 %18 to i32
  call void @_lfortran_printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @1, i32 0, i32 0), i8* %16, i32 %19, i32 1, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @0, i32 0, i32 0), i32 1)
  %20 = icmp eq i8* %11, null
  br i1 %20, label %free_done, label %free_nonnull

free_nonnull:                                     ; preds = %struct_init_done
  call void @_lfortran_free_alloc(i8* %6, i8* %11)
  br label %free_done

free_done:                                        ; preds = %free_nonnull, %struct_init_done
  %21 = load i32, i32* getelementptr inbounds (%foo_c.8, %foo_c.8* @main.foo, i32 0, i32 0, i32 1, i32 1), align 4
  store i32 %21, i32* %4, align 4
  %22 = call i8* (i8*, i8*, i64, i8*, i64*, i32, i32, i32, i32, i32, i32, i32, i32, i8**, ...) @_lcompilers_string_format_fortran(i8* %6, i8* null, i64 0, i8* getelementptr inbounds ([3 x i8], [3 x i8]* @serialization_info.1, i32 0, i32 0), i64* %5, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i8** null, i32* %4)
  %23 = load i64, i64* %5, align 8
  %24 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc1, i32 0, i32 0
  store i8* %22, i8** %24, align 8
  %25 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc1, i32 0, i32 1
  store i64 %23, i64* %25, align 8
  %26 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc1, i32 0, i32 0
  %27 = load i8*, i8** %26, align 8
  %28 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc1, i32 0, i32 1
  %29 = load i64, i64* %28, align 8
  %30 = trunc i64 %29 to i32
  call void @_lfortran_printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @3, i32 0, i32 0), i8* %27, i32 %30, i32 1, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @2, i32 0, i32 0), i32 1)
  %31 = icmp eq i8* %22, null
  br i1 %31, label %free_done3, label %free_nonnull2

free_nonnull2:                                    ; preds = %free_done
  call void @_lfortran_free_alloc(i8* %6, i8* %22)
  br label %free_done3

free_done3:                                       ; preds = %free_nonnull2, %free_done
  %32 = load i32, i32* getelementptr inbounds (%foo_c.8, %foo_c.8* @main.foo, i32 0, i32 1, i32 1), align 4
  store i32 %32, i32* %2, align 4
  %33 = call i8* (i8*, i8*, i64, i8*, i64*, i32, i32, i32, i32, i32, i32, i32, i32, i8**, ...) @_lcompilers_string_format_fortran(i8* %6, i8* null, i64 0, i8* getelementptr inbounds ([3 x i8], [3 x i8]* @serialization_info.2, i32 0, i32 0), i64* %3, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i8** null, i32* %2)
  %34 = load i64, i64* %3, align 8
  %35 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc4, i32 0, i32 0
  store i8* %33, i8** %35, align 8
  %36 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc4, i32 0, i32 1
  store i64 %34, i64* %36, align 8
  %37 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc4, i32 0, i32 0
  %38 = load i8*, i8** %37, align 8
  %39 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc4, i32 0, i32 1
  %40 = load i64, i64* %39, align 8
  %41 = trunc i64 %40 to i32
  call void @_lfortran_printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @5, i32 0, i32 0), i8* %38, i32 %41, i32 1, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @4, i32 0, i32 0), i32 1)
  %42 = icmp eq i8* %33, null
  br i1 %42, label %free_done6, label %free_nonnull5

free_nonnull5:                                    ; preds = %free_done3
  call void @_lfortran_free_alloc(i8* %6, i8* %33)
  br label %free_done6

free_done6:                                       ; preds = %free_nonnull5, %free_done3
  %43 = load i32, i32* getelementptr inbounds (%foo_c.8, %foo_c.8* @main.foo, i32 0, i32 0, i32 0, i32 0, i32 0), align 4
  %44 = load i32, i32* getelementptr inbounds (%foo_c.8, %foo_c.8* @main.foo, i32 0, i32 0, i32 1, i32 1), align 4
  %45 = add i32 %43, %44
  %46 = load i32, i32* getelementptr inbounds (%foo_c.8, %foo_c.8* @main.foo, i32 0, i32 1, i32 1), align 4
  %47 = add i32 %45, %46
  %48 = icmp ne i32 %47, 0
  br i1 %48, label %then, label %else

then:                                             ; preds = %free_done6
  call void (i8*, ...) @_lcompilers_print_error(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @7, i32 0, i32 0), i8* getelementptr inbounds ([11 x i8], [11 x i8]* @"ERROR STOP", i32 0, i32 0), i8* getelementptr inbounds ([2 x i8], [2 x i8]* @6, i32 0, i32 0))
  call void @_lfortran_internal_alloc_finalize()
  call void @exit(i32 1)
  br label %ifcont

else:                                             ; preds = %free_done6
  br label %ifcont

ifcont:                                           ; preds = %else, %then
  br label %return

return:                                           ; preds = %ifcont
  br label %FINALIZE_SYMTABLE_main

FINALIZE_SYMTABLE_main:                           ; preds = %return
  call void @_lfortran_internal_alloc_finalize()
  ret i32 0
}

declare void @_lpython_call_initial_functions(i32, i8**)

declare i8* @_lcompilers_string_format_fortran(i8*, i8*, i64, i8*, i64*, i32, i32, i32, i32, i32, i32, i32, i32, i8**, ...)

declare i8* @_lfortran_get_default_allocator()

declare void @_lfortran_printf(i8*, i8*, i32, i32, i8*, i32)

declare void @_lfortran_free_alloc(i8*, i8*)

declare void @_lcompilers_print_error(i8*, ...)

declare void @_lfortran_internal_alloc_finalize()

declare void @exit(i32)
