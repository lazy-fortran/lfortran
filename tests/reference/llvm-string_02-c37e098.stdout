; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

%string_descriptor = type { i8*, i64 }

@firstname_data = private global [15 x i8] c"               "
@firstname = private global %string_descriptor { i8* getelementptr inbounds ([15 x i8], [15 x i8]* @firstname_data, i32 0, i32 0), i64 15 }
@greetings_data = private global [25 x i8] c"                         "
@greetings = private global %string_descriptor { i8* getelementptr inbounds ([25 x i8], [25 x i8]* @greetings_data, i32 0, i32 0), i64 25 }
@surname_data = private global [15 x i8] c"               "
@surname = private global %string_descriptor { i8* getelementptr inbounds ([15 x i8], [15 x i8]* @surname_data, i32 0, i32 0), i64 15 }
@title_data = private global [6 x i8] c"      "
@title = private global %string_descriptor { i8* getelementptr inbounds ([6 x i8], [6 x i8]* @title_data, i32 0, i32 0), i64 6 }
@string_const_data = private constant [4 x i8] c"Mr. "
@string_const = private global %string_descriptor { i8* getelementptr inbounds ([4 x i8], [4 x i8]* @string_const_data, i32 0, i32 0), i64 4 }
@string_const_data.1 = private constant [6 x i8] c"Rowan "
@string_const.2 = private global %string_descriptor { i8* getelementptr inbounds ([6 x i8], [6 x i8]* @string_const_data.1, i32 0, i32 0), i64 6 }
@string_const_data.3 = private constant [8 x i8] c"Atkinson"
@string_const.4 = private global %string_descriptor { i8* getelementptr inbounds ([8 x i8], [8 x i8]* @string_const_data.3, i32 0, i32 0), i64 8 }
@string_const_data.5 = private constant [25 x i8] c"A big hello from Mr. Bean"
@string_const.6 = private global %string_descriptor { i8* getelementptr inbounds ([25 x i8], [25 x i8]* @string_const_data.5, i32 0, i32 0), i64 25 }
@0 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@serialization_info = private unnamed_addr constant [50 x i8] c"S-DESC-K1-8,S-DESC-K1-6,S-DESC-K1-15,S-DESC-K1-15\00", align 1
@string_const_data.7 = private constant [8 x i8] c"Here is "
@string_const.8 = private global %string_descriptor { i8* getelementptr inbounds ([8 x i8], [8 x i8]* @string_const_data.7, i32 0, i32 0), i64 8 }
@1 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1
@2 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@3 = private unnamed_addr constant [5 x i8] c"%s%s\00", align 1

define i32 @main(i32 %0, i8** %1) {
.entry:
  %stringFormat_desc = alloca %string_descriptor, align 8
  %2 = alloca %string_descriptor, align 8
  %3 = alloca %string_descriptor, align 8
  %4 = alloca %string_descriptor, align 8
  %5 = alloca i64, align 8
  %6 = call i8* @_lfortran_get_default_allocator()
  call void @_lpython_call_initial_functions(i32 %0, i8** %1)
  %7 = load i8*, i8** getelementptr inbounds (%string_descriptor, %string_descriptor* @string_const, i32 0, i32 0), align 8
  call void @_lfortran_strcpy_alloc(i8* %6, i8** getelementptr inbounds (%string_descriptor, %string_descriptor* @title, i32 0, i32 0), i64* getelementptr inbounds (%string_descriptor, %string_descriptor* @title, i32 0, i32 1), i8 0, i8 0, i8* %7, i64 4, i32 1)
  %8 = load i8*, i8** getelementptr inbounds (%string_descriptor, %string_descriptor* @string_const.2, i32 0, i32 0), align 8
  call void @_lfortran_strcpy_alloc(i8* %6, i8** getelementptr inbounds (%string_descriptor, %string_descriptor* @firstname, i32 0, i32 0), i64* getelementptr inbounds (%string_descriptor, %string_descriptor* @firstname, i32 0, i32 1), i8 0, i8 0, i8* %8, i64 6, i32 1)
  %9 = load i8*, i8** getelementptr inbounds (%string_descriptor, %string_descriptor* @string_const.4, i32 0, i32 0), align 8
  call void @_lfortran_strcpy_alloc(i8* %6, i8** getelementptr inbounds (%string_descriptor, %string_descriptor* @surname, i32 0, i32 0), i64* getelementptr inbounds (%string_descriptor, %string_descriptor* @surname, i32 0, i32 1), i8 0, i8 0, i8* %9, i64 8, i32 1)
  %10 = load i8*, i8** getelementptr inbounds (%string_descriptor, %string_descriptor* @string_const.6, i32 0, i32 0), align 8
  call void @_lfortran_strcpy_alloc(i8* %6, i8** getelementptr inbounds (%string_descriptor, %string_descriptor* @greetings, i32 0, i32 0), i64* getelementptr inbounds (%string_descriptor, %string_descriptor* @greetings, i32 0, i32 1), i8 0, i8 0, i8* %10, i64 25, i32 1)
  %11 = load %string_descriptor, %string_descriptor* @title, align 8
  store %string_descriptor %11, %string_descriptor* %4, align 8
  %12 = load %string_descriptor, %string_descriptor* @firstname, align 8
  store %string_descriptor %12, %string_descriptor* %3, align 8
  %13 = load %string_descriptor, %string_descriptor* @surname, align 8
  store %string_descriptor %13, %string_descriptor* %2, align 8
  %14 = call i8* (i8*, i8*, i64, i8*, i64*, i32, i32, i32, i32, i32, i32, i32, i32, i8**, ...) @_lcompilers_string_format_fortran(i8* %6, i8* null, i64 0, i8* getelementptr inbounds ([50 x i8], [50 x i8]* @serialization_info, i32 0, i32 0), i64* %5, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i8** null, %string_descriptor* @string_const.8, %string_descriptor* %4, %string_descriptor* %3, %string_descriptor* %2)
  %15 = load i64, i64* %5, align 8
  %16 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 0
  store i8* %14, i8** %16, align 8
  %17 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 1
  store i64 %15, i64* %17, align 8
  %18 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 0
  %19 = load i8*, i8** %18, align 8
  %20 = getelementptr %string_descriptor, %string_descriptor* %stringFormat_desc, i32 0, i32 1
  %21 = load i64, i64* %20, align 8
  %22 = trunc i64 %21 to i32
  call void @_lfortran_printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @1, i32 0, i32 0), i8* %19, i32 %22, i32 1, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @0, i32 0, i32 0), i32 1)
  %23 = icmp eq i8* %14, null
  br i1 %23, label %free_done, label %free_nonnull

free_nonnull:                                     ; preds = %.entry
  call void @_lfortran_free_alloc(i8* %6, i8* %14)
  br label %free_done

free_done:                                        ; preds = %free_nonnull, %.entry
  %24 = load i8*, i8** getelementptr inbounds (%string_descriptor, %string_descriptor* @greetings, i32 0, i32 0), align 8
  call void @_lfortran_printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @3, i32 0, i32 0), i8* %24, i32 25, i32 1, i8* getelementptr inbounds ([2 x i8], [2 x i8]* @2, i32 0, i32 0), i32 1)
  br label %return

return:                                           ; preds = %free_done
  br label %FINALIZE_SYMTABLE_string_02

FINALIZE_SYMTABLE_string_02:                      ; preds = %return
  call void @_lfortran_internal_alloc_finalize()
  ret i32 0
}

declare void @_lpython_call_initial_functions(i32, i8**)

declare void @_lfortran_strcpy_alloc(i8*, i8**, i64*, i8, i8, i8*, i64, i32)

declare i8* @_lfortran_get_default_allocator()

declare i8* @_lcompilers_string_format_fortran(i8*, i8*, i64, i8*, i64*, i32, i32, i32, i32, i32, i32, i32, i32, i8**, ...)

declare void @_lfortran_printf(i8*, i8*, i32, i32, i8*, i32)

declare void @_lfortran_free_alloc(i8*, i8*)

declare void @_lfortran_internal_alloc_finalize()
