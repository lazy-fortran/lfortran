; ModuleID = 'LFortran'
source_filename = "LFortran"
target datalayout = "..."

@nullify_02.p1 = internal global float* null
@nullify_02.p2 = internal global i32* null
@nullify_02.t1 = internal global float 0.000000e+00
@nullify_02.t2 = internal global i32 0

define i32 @main(i32 %0, i8** %1) {
.entry:
  call void @_lpython_call_initial_functions(i32 %0, i8** %1)
  store float* @nullify_02.t1, float** @nullify_02.p1, align 8
  %2 = load float*, float** @nullify_02.p1, align 8
  store float 1.000000e+00, float* %2, align 4
  store i32* @nullify_02.t2, i32** @nullify_02.p2, align 8
  %3 = load i32*, i32** @nullify_02.p2, align 8
  store i32 2, i32* %3, align 4
  store float* null, float** @nullify_02.p1, align 8
  store i32* null, i32** @nullify_02.p2, align 8
  br label %return

return:                                           ; preds = %.entry
  br label %FINALIZE_SYMTABLE_nullify_02

FINALIZE_SYMTABLE_nullify_02:                     ; preds = %return
  call void @_lfortran_internal_alloc_finalize()
  ret i32 0
}

declare void @_lpython_call_initial_functions(i32, i8**)

declare void @_lfortran_internal_alloc_finalize()
